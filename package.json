{
  "name": "mdrules",
  "version": "0.2.1",
  "description": "Visual editor for CLAUDE.md, AGENTS.md and /docs — humans edit comfortably, the AI keeps reading plain Markdown.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "live-preview",
    "claude",
    "claude-code",
    "agents-md",
    "ai-agents",
    "documentation",
    "codemirror",
    "mermaid",
    "cli"
  ],
  "homepage": "https://github.com/rafiqui1987/mdrules#readme",
  "bugs": {
    "url": "https://github.com/rafiqui1987/mdrules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafiqui1987/mdrules.git"
  },
  "license": "MIT",
  "author": "rafiqui1987",
  "type": "module",
  "bin": {
    "mdrules": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/cli/index.ts serve --port 4319 --no-open\" \"vite\"",
    "build": "vite build && tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chokidar": "^6.0.0",
    "ignore": "^7.0.13",
    "open": "^11.0.4",
    "picocolors": "^1.1.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "katex": "^0.19.0",
    "lucide": "^1.59.0",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
